{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "reimalstore.chainasiaconnect.co.id"
        }
      ],
      "destination": "/reimalstore/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "reimalstore.chainasiaconnect.co.id"
        }
      ],
      "destination": "/reimalstore/index.html"
    }
  ]
}
